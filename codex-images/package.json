{
  "name": "@local/codex-images",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browse the current project's Codex-generated images, manage them with the agent, and sign in to an isolated Codex account.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/project.js",
    "lib/codex.js",
    "lib/bridge.js",
    "lib/cdn.js",
    "lib/appserver.js",
    "lib/exec.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
