{
  "name": "@local/codex-fast-mode",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Session-local Fast Mode for the DSH OpenAI Codex route",
  "engines": { "dsh": "0.2.2-rc.5" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "fast.js", "client.js", "cordis.patch.yml", "locale", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-model-selection"] }
  }
}
