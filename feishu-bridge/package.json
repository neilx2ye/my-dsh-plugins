{
  "name": "@local/feishu-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Talk to the Harness from Feishu over a WebSocket long connection: one durable Session per chat, streamed replies, no public callback URL.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}