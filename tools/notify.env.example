# 复制成 notify.env（同目录）或 ~/.config/dsh/notify.env，然后填你自己的凭证。
# 只需要配一个通道。

# ===== 选一个通道 =====
# wework | wework-app | serverchan | pushplus | wxpusher
NOTIFY_CHANNEL=pushplus


# --- 1) 企业微信群机器人（最简单，消息进企业微信；开"微信插件"后微信里也能收） ---
# 企业微信群 → 右上角 … → 群机器人 → 添加 → 复制 Webhook 地址
# WEWORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx


# --- 2) 企业微信自建应用（可推到个人微信：企业微信后台开"微信插件"，微信扫码关注） ---
# 企业微信管理后台 → 应用管理 → 自建 → 创建应用
# WEWECOM_CORPID=ww1234567890abcdef
# WEWECOM_CORPSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WEWECOM_AGENTID=1000002
# WEWECOM_TOUSER=@all


# --- 3) Server酱 / 方糖（个人微信，关注"方糖"公众号拿 SendKey） ---
# https://sct.ftqq.com/
# SERVERCHAN_SENDKEY=SCTxxxxxxxxxxxxxxxx


# --- 4) PushPlus（个人微信，关注"pushplus推送加"公众号拿 token，免费 200 条/天） ---
# https://www.pushplus.plus/
PUSHPLUS_TOKEN=


# --- 5) WxPusher（个人微信，关注公众号拿 appToken 和 UID） ---
# https://wxpusher.zjiecode.com/
# WXPUSHER_APP_TOKEN=AT_xxxxxxxxxxxx
# WXPUSHER_UIDS=UID_xxxxxxxx