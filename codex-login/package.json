{
  "name": "@local/codex-login",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sign in to ChatGPT / Codex from the Models settings page, so the pi-ai openai-codex route uses a subscription instead of an API key.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  }
}